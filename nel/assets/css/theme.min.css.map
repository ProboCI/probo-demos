  width: 100%;
  height: 100%; }

/**
 * Lightbox
 */
.lightbox {
  display: flex;
  flex-direction: column;
  position: relative;
  /* size, with fallbacks */
  max-width: 100%;
  max-width: calc(100% - 30px);
  max-height: 100%;
  max-height: calc(100% - 30px);
  /* decoration */
  background: #fff; }
  .lightbox .lightbox-title {
    display: none; }
  .lightbox .lightbox-close {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    right: -20px;
    top: -20px;
    width: 40px;
    height: 40px;
    background-repeat: no-repeat;
    border: 1px solid white;
    border-radius: 50%;
    background-color: rgba(0, 0, 0, 0.8);
    cursor: pointer;
    color: #fff; }
    .lightbox .lightbox-close:before {
      content: "";
