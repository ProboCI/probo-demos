<section class="usda-search-header">
  <div class="usa-grid">
    <header class="header">
      <h1>Search</h1>
    </header>
    <div class="main">
      <form method="get" action="/search">
        <div class="query">
          {# <label class="label" for="query">Refine by keyword or phrase:</label> #}
          <input type="text" name="query" id="query" placeholder="Search by keyword or phrase..." value="{{ search_query }}">
        </div>
        <div class="action">
          <button class="usa-button usa-button-secondary" type="submit">Search</button>
        </div>
      </form>
    </div>
  </div>
</section>
