{%
  set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  ]
%}
{% block paragraph %}
  <div{{ attributes.addClass(classes) }}>

    {% if uswds_grid_class %}
    <div class="{{ uswds_grid_class }}">
    {% endif %}

    <ul class="usda-infographic-accordion usa-accordion">
      {% block content %}

        {% for key,value in paragraph.field_paragraphs.value %}
          {{ content.field_paragraphs[key] }}
        {% endfor %}

      {% endblock %}
    </ul>

    {% if uswds_grid_class %}
    </div>
    {% endif %}

  </div>
{% endblock paragraph %}
