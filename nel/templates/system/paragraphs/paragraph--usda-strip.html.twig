{%
  set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    'usa-section',
    'usa-content',
  ]
%}
{% block paragraph %}
  <div{{ attributes.addClass(classes) }}>
    {% block content %}

      {% for key,value in paragraph.field_strip_boxes.value %}
        {% if content.field_strip_boxes[key] is not empty %}
          {{ content.field_strip_boxes[key] }}
        {% endif %}
      {% endfor %}

    {% endblock %}
  </div>
{% endblock paragraph %}
