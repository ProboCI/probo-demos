<div class="project-page-teaser-panel">
  <div class="pictext">
    <div class="pic">
      {{ content.field_featured_image }}
    </div>
    <div class="text">
      <div class="title">
        {{ label }}
      </div>
      <div class="summary">
        {{ content.field_summary }}
      </div>
      <div class="actions">
        <a href="{{ url }}" class="usa-button usa-button-secondary">View {{ label }}</a>
      </div>
    </div>
  </div>
</div>
